# REDY GO — Environment Variables
# Copy this file to .env and fill in the values

# Telegram Bot (from @BotFather)
BOT_TOKEN=1234567890:AAABBBCCC_your_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# CryptoBot Crypto Pay API (from @CryptoBot → Create App)
CRYPTO_API_TOKEN=AAAA:your_cryptobot_api_token_here

# PostgreSQL Database URL
# Railway auto-populates this if you add a PostgreSQL service
# For local dev: postgresql://username:password@localhost:5432/redygo
DATABASE_URL=postgresql://user:password@host:5432/database

# Server Port (Railway sets this automatically)
PORT=3000

# Your deployed app URL (used for webhook info in README)
APP_URL=https://your-app-name.up.railway.app
